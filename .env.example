# --- Aplicación ---
# URL pública (se usa en los enlaces de los correos). Ej.: https://academy.tuio.com
APP_URL=
# Ruta del fichero SQLite
DATABASE_PATH=data/tuio-academy.db
# Cuenta inicial de superadministración (solo se usa al crear la BD por primera vez)
ADMIN_EMAIL=formacion@tuio.com
ADMIN_PASSWORD=CambiaEsto-2026
# Dominios de email permitidos para auto-registro, separados por comas (vacío = cualquiera)
ALLOWED_EMAIL_DOMAINS=

# --- Correo (remitente formacion@tuio.com) ---
# smtp = envío real · log = no envía, guarda cada correo en data/outbox (pruebas) · vacío = automático (smtp si hay SMTP_HOST)
MAIL_TRANSPORT=
MAIL_FROM="Tuio Academy <formacion@tuio.com>"
MAIL_REPLY_TO=formacion@tuio.com
# Google Workspace: smtp.gmail.com, puerto 465, usuario formacion@tuio.com y una contraseña de aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=formacion@tuio.com
SMTP_PASS=

# --- Recordatorios automáticos ---
# Clave que debe enviar el cron del servidor a /api/cron/recordatorios (genera una larga y aleatoria)
CRON_SECRET=
